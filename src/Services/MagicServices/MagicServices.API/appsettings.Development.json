        "Args": {
          "connectionString": "Server=localhost;Database=MagicPro;User Id=sa;Password=P@ssw0rd;Encrypt=False;TrustServerCertificate=True;",
          "tableName": "Logs",
          "autoCreateSqlTable": true,
          "restrictedToMinimumLevel": "Information",
